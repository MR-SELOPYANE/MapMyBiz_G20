# Supabase configuration
# Copy this file to .env and fill in your project values.
# Authentication is Supabase only — no Clerk keys are needed.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Emails (comma separated) allowed to open /admin
VITE_ADMIN_EMAILS=admin@mapmybizz.co.za

# Optional: endpoint that receives AI business analysis requests.
# Point it at your own backend (it should POST the metrics payload and
# return { score, headline, insights[], actions[], focus }).
# When this is empty the app runs a built-in on-device analysis instead,
# which keeps the feature working with no backend and no data.
VITE_AI_ANALYSIS_URL=
